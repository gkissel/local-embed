{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localembed.dev/contracts/localembed/v1/schema.json",
  "title": "LocalEmbed configuration v1",
  "description": "Declarative, language-independent configuration for LocalEmbed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "entities"],
  "properties": {
    "version": { "const": "localembed/v1" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/provider" }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity" }
    },
    "operations": { "$ref": "#/$defs/operations" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "qualifiedIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "endpoint", "model", "dimensions", "metric", "secret_env"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["tei", "openai"] },
        "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metric": { "enum": ["cosine", "dot_product", "l2"] },
        "max_batch_size": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 32 },
        "secret_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "external_data_transfer_accepted": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "openai" } } },
          "then": {
            "properties": { "external_data_transfer_accepted": { "const": true } },
            "required": ["external_data_transfer_accepted"]
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "provider", "template", "destination"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "id", "detection"],
          "properties": {
            "table": { "$ref": "#/$defs/qualifiedIdentifier" },
            "id": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "type"],
              "properties": {
                "column": { "$ref": "#/$defs/identifier" },
                "type": { "enum": ["uuid", "bigint", "text", "ulid"] }
              }
            },
            "detection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["trigger", "polling"] },
                "updated_at": { "$ref": "#/$defs/identifier" }
              },
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "polling" } } },
                  "then": {
                    "properties": { "updated_at": { "$ref": "#/$defs/identifier" } },
                    "required": ["updated_at"]
                  }
                }
              ]
            }
          }
        },
        "provider": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true,
          "default": []
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relation", "fields"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "relation": { "enum": ["one", "many"] },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/identifier" },
                "uniqueItems": true
              }
            }
          },
          "default": []
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[^{}]|\\{\\{[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?\\}\\})+$"
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table"],
          "properties": {
            "table": { "$ref": "#/$defs/qualifiedIdentifier" },
            "hnsw": { "$ref": "#/$defs/hnsw" }
          }
        }
      }
    },
    "hnsw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "m": { "type": "integer", "minimum": 2, "maximum": 100, "default": 16 },
        "ef_construction": { "type": "integer", "minimum": 4, "maximum": 1000, "default": 64 }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backfill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 100 }
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 0, "maximum": 100, "default": 5 }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval_seconds": { "type": "integer", "minimum": 60, "default": 3600 }
          }
        }
      }
    }
  }
}
