{
  "name": "localembed",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "workspace": [
    "services/*",
    "docs/site"
  ],
  "imports": {
    "@apidevtools/swagger-parser": "npm:@apidevtools/swagger-parser@^12.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "ajv": "npm:ajv@^8.20.0",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0"
  },
  "tasks": {
    "check": "deno fmt --check deno.json mod.ts README.md contracts services scripts examples deployments/runtime docs/site tests && deno lint services scripts examples deployments/runtime docs/site tests && deno check scripts/prepare_docs.ts scripts/validate_contracts.ts docs/site/_config.ts tests/contracts_test.ts services/admin/main.ts services/worker/main.ts scripts/measure_queue.ts scripts/measure_retention.ts scripts/measure_indexes.ts scripts/evaluation/run.ts services/api/main.ts services/poller/main.ts services/telemetry/main.ts scripts/verify_telemetry.ts examples/hybrid-search/main.ts examples/hybrid-search/setup.ts scripts/compare_hybrid_storage.ts deployments/runtime/bootstrap.ts deployments/runtime/probe.ts scripts/deployment/smoke.ts",
    "validate:contracts": "deno run --allow-read --allow-net --allow-env scripts/validate_contracts.ts",
    "docs:prepare": "deno run --allow-read --allow-write scripts/prepare_docs.ts",
    "docs:build": "deno task docs:prepare && deno task --cwd docs/site build",
    "docs:serve": "deno task docs:prepare && deno task --cwd docs/site serve",
    "test": "deno test --allow-read tests",
    "localembed": "deno run --allow-read --allow-env --allow-net services/admin/main.ts",
    "test:integration": "deno test --allow-read --allow-env --allow-net tests/*integration_test.ts",
    "worker": "deno run --allow-env --allow-net services/worker/main.ts",
    "api": "deno run --allow-env --allow-net services/api/main.ts",
    "poller": "deno run --allow-env --allow-net services/poller/main.ts",
    "telemetry": "deno run --allow-env --allow-net services/telemetry/main.ts",
    "verify:telemetry": "deno run --allow-read --allow-env --allow-net scripts/verify_telemetry.ts",
    "demo:setup": "deno run --allow-read --allow-env --allow-net examples/hybrid-search/setup.ts",
    "demo:search": "deno run --allow-env --allow-net examples/hybrid-search/main.ts",
    "verify:deployment": "scripts/deployment/verify-packaging.sh",
    "verify:deployment:tei": "deno run --allow-read=deployments/.secrets/service_key --allow-env --allow-net scripts/deployment/smoke.ts",
    "measure:retention": "deno run --allow-read --allow-write --allow-env --allow-net scripts/measure_retention.ts",
    "demo:compare": "deno run --allow-read --allow-write --allow-env --allow-net scripts/compare_hybrid_storage.ts",
    "measure:indexes": "deno run --allow-read --allow-write --allow-env --allow-net scripts/measure_indexes.ts",
    "evaluate": "scripts/evaluation/run.sh"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
